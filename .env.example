# Groq handles the PLP writer and the app's interactive language features.
# The PLP uses 120B so it does not share the 20B token window used by chat/news.
PRONUNCIATION_COACH_PROVIDER=groq
GROQ_GENERAL_MODEL=openai/gpt-oss-20b
GROQ_PRONUNCIATION_MODEL=openai/gpt-oss-120b
# Supply one key or an ordered, comma-separated pool of authorized keys.
# Interactive features use the first key; PLP generation round-robins all keys.
GROQ_API_KEYS=
GROQ_PLP_MODEL=openai/gpt-oss-120b

# Required only for live, user-selected News categories.
NEWSAPI_KEY=

# Bind locally by default. Use a trusted reverse proxy for remote deployment.
SPEAKFLOW_HOST=127.0.0.1
SPEAKFLOW_PORT=8000

DATABASE_URL=postgresql+psycopg://english_tutor:english_tutor@127.0.0.1:5432/english_tutor
POSTGRES_DB=english_tutor
POSTGRES_USER=english_tutor
POSTGRES_PASSWORD=english_tutor
POSTGRES_PORT=5432
PLP_DATA_ROOT=.local_data

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=embeddinggemma:latest
